{
  "name": "open-xiangqi-format-dev",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Development scripts for the Open Xiangqi Format project",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node script/check-environment.mjs",
    "ci": "node script/ci.mjs",
    "release:check": "node script/package-release.mjs --check",
    "release:package": "node script/package-release.mjs",
    "test": "node --test script/test/*.test.mjs",
    "vectors:check": "node script/build-oxq-vectors.mjs",
    "vectors:write": "node script/build-oxq-vectors.mjs --write"
  }
}
