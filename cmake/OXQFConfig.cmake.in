@PACKAGE_INIT@

# OXQF's compiler-labelled Windows SDK is built with the static MSVC runtime.
# Apply the matching default to consumer targets created after find_package(),
# while preserving an explicit choice made by the consuming project.
if(MSVC AND NOT DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
  set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OXQFTargets.cmake")

# Compatibility target for consumers of OXQF 1.x. It intentionally resolves to
# the same binary as OXQF::format and will be removed in the next major version.
if(TARGET OXQF::format AND NOT TARGET OXQF::core)
  add_library(OXQF::core INTERFACE IMPORTED)
  set_property(
    TARGET OXQF::core
    PROPERTY INTERFACE_LINK_LIBRARIES OXQF::format
  )
endif()

check_required_components(OXQF)
